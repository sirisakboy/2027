  "plugins": {
    "shell": { "all": false, "open": true },
    "dialog": { "all": true },
    "fs": { "all": true, "scope": ["$RESOURCE/**", "$APPDATA/**"] }
  },
  "productName": "REMAP V.5",
  "version": "5.0.7",
  "identifier": "com.sirisakboy.remapv5"
