{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "deb", "appimage"],
    "category": "DeveloperTool",
    "copyright": "© sirisakboy REMAP V.5",
    "icon": ["icons/icon.ico", "icons/icon.icns", "icons/icon.png", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "longDescription": "Motorbike ECU Remapping Program for Honda - รองรับทุกแพลตฟอร์ม",
    "shortDescription": "REMAP V.5 - Honda ECU Tuning"
